rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    // Admins (the app's owner). Added by hand in the Firebase console: collection "admins", document ID = the
    // admin's user ID. Nobody can add or change admins from the apps.
    function isAdmin() { return request.auth != null && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;       // lets the app check "am I an admin?"
      allow list, write: if false;
    }

    // A family's players and practice history.
    // Signed-in families: only members can reach it – parent accounts and paired practice devices, listed in
    // `members` ({uid: {role: 'parent' | 'device', …}}). A device joins with a short-lived pairing code (see pairs/)
    // and can only add or remove itself; parents manage everyone. Removing a device ends its access at once.
    // Older families without `members` still work with their long random code until a parent signs in and moves them.
    function members() { return resource.data.get('members', {}); }
    function isMember() { return request.auth != null && request.auth.uid in members(); }
    function isParent() { return isMember() && members()[request.auth.uid].role == 'parent'; }
    function legacy() { return !('members' in resource.data); }
    function isPerson() { return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function pairOk(family, m) {
      let p = get(/databases/$(db)/documents/pairs/$(m.pair)).data;
      return p.family == family && p.expires > request.time && m.role == p.role && (m.role == 'device' || isPerson());
    }
    match /families/{family} {
      allow get: if isMember() || (legacy() && family.size() >= 20);
      allow create: if family.size() >= 20 && (!('members' in request.resource.data)
        || (isPerson() && request.resource.data.members.keys().hasOnly([request.auth.uid])
            && request.resource.data.members[request.auth.uid].role == 'parent'));
      allow update: if
        // a parent: anything
        isParent()
        // a device: anything but the member list – except taking itself off it
        || (isMember() && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['members'])
            || request.resource.data.members.keys().toSet() == members().keys().toSet().difference([request.auth.uid].toSet())))
        // joining with a pairing code: adds only itself, with the role the code was made for
        || (request.auth != null && !isMember() && !legacy()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && request.resource.data.members.diff(members()).affectedKeys().hasOnly([request.auth.uid])
            && pairOk(family, request.resource.data.members[request.auth.uid]))
        // an older family: the code still works, and a parent signing in moves it to members
        || (legacy() && family.size() >= 20 && (!('members' in request.resource.data)
            || (isPerson() && request.resource.data.members.keys().hasOnly([request.auth.uid])
                && request.resource.data.members[request.auth.uid].role == 'parent')));
      allow list, delete: if false;
    }
    // Pairing codes: a parent makes one (valid 15 minutes) to add a practice device or another parent;
    // the device that uses it deletes it. 8 random characters, so they can't be guessed in that time.
    match /pairs/{code} {
      allow get: if request.auth != null && code.size() >= 8;
      allow create: if request.auth != null && code.size() >= 8 && request.resource.data.by == request.auth.uid
        && request.resource.data.role in ['device', 'parent']
        && request.resource.data.expires < request.time + duration.value(16, 'm')
        && get(/databases/$(db)/documents/families/$(request.resource.data.family)).data.get('members', {})[request.auth.uid].role == 'parent';
      allow delete: if request.auth != null;
      allow list, update: if false;
    }

    // A parent's own sign-in record (optional Google sign-in in the family app): which family they belong to.
    // Only that parent can read or change it, and it can only point at a family that exists.
    match /parents/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['family', 'email', 'name', 'at'])
        && request.resource.data.family is string && request.resource.data.family.size() >= 20
        && exists(/databases/$(db)/documents/families/$(request.resource.data.family));
    }

    // A teacher's studio and everything private to it (lessons, recitals, notes).
    // Only the signed-in teacher who owns it can read or write.
    // The studio's plan (Free, or Beta partner) can only be changed by redeeming an unused beta code in the
    // same write, or by an admin.
    match /studios/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid && !('plan' in request.resource.data);
      allow update: if isAdmin() || (request.auth != null && request.auth.uid == uid && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan'])
        || (request.resource.data.plan.tier == 'beta'
            && getAfter(/databases/$(db)/documents/betaCodes/$(request.resource.data.plan.code)).data.usedBy == request.auth.uid)));
      allow delete: if false;
      // Everything inside the studio (lessons, recitals, notes). "{sub}/" makes sure this only matches documents
      // below the studio – a bare {document=**} would also match the studio record itself and bypass the plan rule.
      match /{sub}/{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // A teacher's calendar & email settings, read by the calendar/email service using the long random token.
    match /feeds/{token} {
      allow get: if token.size() >= 20;
      allow create: if request.auth != null && request.resource.data.studioId == request.auth.uid && token.size() >= 20;
      allow update, delete: if request.auth != null && resource.data.studioId == request.auth.uid
        && (!('studioId' in request.resource.data) || request.resource.data.studioId == request.auth.uid);
      allow list: if false;
    }

    // Beta codes: single use. A signed-in teacher can look up a code they were given and claim it once.
    match /betaCodes/{code} {
      allow get: if request.auth != null;
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || (request.auth != null && resource.data.usedBy == null && resource.data.revoked != true
        && request.resource.data.usedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedBy', 'usedAt', 'usedByName']));
    }

    // Beta requests (landing page form) and feedback (both apps): anyone can send one; only admins read them.
    match /betaRequests/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name', 'studio', 'email', 'students', 'instruments', 'message', 'at'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.get('message', '').size() <= 2000 && request.resource.data.name.size() <= 120;
      allow read, update, delete: if isAdmin();
    }
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['from', 'role', 'rating', 'message', 'page', 'at', 'studioId', 'contact'])
        && request.resource.data.message is string && request.resource.data.message.size() <= 4000
        && (!('studioId' in request.resource.data) || (request.auth != null && request.resource.data.studioId == request.auth.uid));
      allow read, update, delete: if isAdmin();
    }

    // One student: shared between their teacher and their family.
    // The student code (sent to the family as an invite link) is long and random.
    match /students/{sid} {
      // Teacher: full control of their own students
      allow read, update, delete: if request.auth != null && resource.data.studioId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.studioId == request.auth.uid && sid.size() >= 20;
      // Family (holds the code): can read it, and can only update their child's practice data, assignment ticks,
      // earned badges, which stars they've seen, which challenges they've finished, consent, and the child's photo
      allow get: if sid.size() >= 20;
      allow update: if sid.size() >= 20
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['practice', 'progress', 'linkedAt', 'kidName', 'badges', 'cheersSeen', 'challengeDone', 'consent', 'photo'])
        // a photo is a small picture (about 10 KB), never a big file
        && (!('photo' in request.resource.data) || request.resource.data.photo == null
            || (request.resource.data.photo is string && request.resource.data.photo.size() < 40000));

      // Recordings a student sends their teacher (short audio clips, made only when someone presses Record).
      // clips/{id} = who, when, which assignment and the teacher's reply; clipData/{id} = the audio itself.
      // The family (holds the code) sends and can delete them; only the student's teacher can reply.
      function teacherOf() { return get(/databases/$(db)/documents/students/$(sid)).data.studioId; }
      match /clips/{cid} {
        allow get, list: if sid.size() >= 20;
        allow create: if sid.size() >= 20
          && request.resource.data.keys().hasOnly(['at', 'assignment', 'title', 'secs', 'mime', 'kidName', 'studioId'])
          && request.resource.data.studioId == teacherOf()
          && request.resource.data.secs is number && request.resource.data.secs <= 120
          && request.resource.data.get('title', '').size() <= 200;
        allow update: if request.auth != null && teacherOf() == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply', 'replyAt', 'heard'])
          && request.resource.data.get('reply', '').size() <= 1000;
        allow delete: if sid.size() >= 20;
      }
      match /clipData/{cid} {
        allow get: if sid.size() >= 20;
        allow create: if sid.size() >= 20 && request.resource.data.keys().hasOnly(['data', 'mime'])
          && request.resource.data.data is string && request.resource.data.data.size() < 900000;
        allow delete: if sid.size() >= 20;
        allow list, update: if false;
      }
    }
  }
}
